@echo off
setlocal
set "PS_FILE=%TEMP%\GW_FULL_LAUNCHER.ps1"
if exist "%PS_FILE%" del "%PS_FILE%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$p='%~f0'; $f=[IO.File]::ReadAllLines($p, [Text.Encoding]::UTF8); $i=-1; for($n=0;$n -lt $f.Length;$n++){if($f[$n] -match '^#PS_START'){$i=$n;break}}; if($i -ge 0){[IO.File]::WriteAllLines('%PS_FILE%',$f[$i..($f.Length-1)],(New-Object Text.UTF8Encoding $true))}"
if not exist "%PS_FILE%" ( pause & exit /b )
powershell -NoProfile -ExecutionPolicy Bypass -STA -File "%PS_FILE%"
set RC=%ERRORLEVEL%
if exist "%PS_FILE%" del "%PS_FILE%"
goto :eof

#PS_START$ErrorActionPreference = "Stop"
Add-Type -AssemblyName PresentationFramework
Add-Type -AssemblyName PresentationCore
Add-Type -AssemblyName WindowsBase

$dir = "$env:APPDATA\GhostWorld"
if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
$licFile = Join-Path $dir "license.txt"

$hwid = (Get-CimInstance Win32_ComputerSystemProduct).UUID
$accent = "#00FFCC"

$rawKeys = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String(""))
$keysArray = $rawKeys -split "`n" | Where-Object { $_.Trim() -ne "" }

function Run-App($appType) {
    $tmpDir = $env:TEMP
    if ($appType -eq "ADM" -or $appType -eq "BOTH") {
        $p = Join-Path $tmpDir "gw_adm_$(Get-Random).bat"
        [IO.File]::WriteAllBytes($p, [Convert]::FromBase64String(""))
        Start-Process "cmd.exe" -ArgumentList "/c `"$p`"" -WindowStyle Hidden
    }
    if ($appType -eq "CHK" -or $appType -eq "BOTH") {
        $p = Join-Path $tmpDir "gw_chk_$(Get-Random).bat"
        [IO.File]::WriteAllBytes($p, [Convert]::FromBase64String(""))
        Start-Process "cmd.exe" -ArgumentList "/c `"$p`"" -WindowStyle Hidden
    }
}

function Check-Key($key) {
    if (-not $key) { return $null }
    $cleanKey = $key.Split('|')[0].Trim()
    foreach ($line in $keysArray) {
        $parts = $line.Split('|')
        if ($parts[0] -eq $cleanKey) { return $parts[1] }
    }
    return $null
}

$access = $null
if (Test-Path $licFile) {
    $stored = [IO.File]::ReadAllText($licFile).Trim()
    $parts = $stored.Split('|')
    if ($parts[0] -eq $hwid) { $access = Check-Key $parts[1] }
}

if (-not $access) {
    $lx = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GW" Height="360" Width="480" Background="Transparent" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">
<Border CornerRadius="10" BorderBrush="#333" BorderThickness="1" Background="#151515">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="GHOSTWORLD" Foreground="$accent" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            <TextBlock Text="Enter license key" Foreground="#888" FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,5,0,25"/>
            <TextBox x:Name="txtKey" Height="45" Background="#0A0A0A" Foreground="#FFF" BorderBrush="#444" BorderThickness="1" FontSize="16" FontFamily="Consolas" Padding="10,0" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="txtErr" Foreground="#FF4444" FontSize="12" FontFamily="Segoe UI" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <Button x:Name="btnLogin" Content="LOGIN" Height="45" Margin="0,20,0,0" Background="$accent" Foreground="#000" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnClose" Content="Close" Background="Transparent" Foreground="#666" BorderThickness="0" Margin="0,15,0,0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Border>
</Window>
"@
    $lw = [Windows.Markup.XamlReader]::Load((New-Object Xml.XmlNodeReader ([xml]$lx)))
    $lw.Add_MouseLeftButtonDown({ try { $lw.DragMove() } catch {} })
    $lw.FindName("btnClose").Add_Click({ $lw.Close(); exit })
    
    $lw.FindName("btnLogin").Add_Click({
        $k = $lw.FindName("txtKey").Text
        $res = Check-Key $k
        if ($res) {
            [IO.File]::WriteAllText($licFile, "$hwid|$($k.Split('|')[0].Trim())")
            $lw.Tag = $res
            $lw.Close()
        } else {
            $lw.FindName("txtErr").Text = "Wrong key!"
            $lw.FindName("txtKey").SelectAll()
        }
    })
    $lw.FindName("txtKey").Add_KeyDown({ if ($_.Key -eq 'Enter') { $lw.FindName("btnLogin").RaiseEvent((New-Object Windows.RoutedEventArgs([Windows.Controls.Button]::ClickEvent))) } })
    $lw.ShowDialog() | Out-Null
    $access = $lw.Tag
    if (-not $access) { exit }
}

$mx = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GW" Height="480" Width="480" Background="Transparent" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">
<Border CornerRadius="10" BorderBrush="#333" BorderThickness="1" Background="#151515">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="GHOSTWORLD" Foreground="$accent" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtAccess" Foreground="#888" FontSize="12" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,5,0,30"/>
            <Button x:Name="btnApp1" Content="ADMIN TOOL" Height="50" Margin="0,0,0,15" Background="#222" Foreground="$accent" FontWeight="Bold" FontSize="16" BorderThickness="1" BorderBrush="#444" Cursor="Hand"/>
            <Button x:Name="btnApp2" Content="CHECKER V38" Height="50" Margin="0,0,0,15" Background="#222" Foreground="$accent" FontWeight="Bold" FontSize="16" BorderThickness="1" BorderBrush="#444" Cursor="Hand"/>
            <Button x:Name="btnApp3" Content="RUN BOTH" Height="50" Margin="0,0,0,15" Background="$accent" Foreground="#000" FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand"/>
            
            <Button x:Name="btnLogout" Content="CHANGE KEY" Height="30" Margin="0,10,0,0" Background="Transparent" Foreground="#FF4444" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnClose" Content="EXIT" Background="Transparent" Foreground="#666" BorderThickness="0" Margin="0,5,0,0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Border>
</Window>
"@
$mw = [Windows.Markup.XamlReader]::Load((New-Object Xml.XmlNodeReader ([xml]$mx)))
$mw.Add_MouseLeftButtonDown({ try { $mw.DragMove() } catch {} })
$mw.FindName("txtAccess").Text = "Access: $($access.ToString().Trim())"
$mw.FindName("btnClose").Add_Click({ $mw.Close() })

$mw.FindName("btnLogout").Add_Click({ 
    Remove-Item $licFile -Force -ErrorAction SilentlyContinue
    $mw.Close()
    exit
})

if ($access.ToString().Trim() -eq "ADM") { 
    $mw.FindName("btnApp2").Visibility = [Windows.Visibility]::Collapsed
    $mw.FindName("btnApp3").Visibility = [Windows.Visibility]::Collapsed
} elseif ($access.ToString().Trim() -eq "CHK") { 
    $mw.FindName("btnApp1").Visibility = [Windows.Visibility]::Collapsed
    $mw.FindName("btnApp3").Visibility = [Windows.Visibility]::Collapsed
}

$mw.FindName("btnApp1").Add_Click({ Run-App "ADM"; $mw.Close() })
$mw.FindName("btnApp2").Add_Click({ Run-App "CHK"; $mw.Close() })
$mw.FindName("btnApp3").Add_Click({ Run-App "BOTH"; $mw.Close() })
$mw.ShowDialog() | Out-Null